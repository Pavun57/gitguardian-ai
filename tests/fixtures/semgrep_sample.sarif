{
  "version": "2.1.0",
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "semgrep",
          "rules": [
            {
              "id": "gitguardian.python-subprocess-shell",
              "properties": {"severity": "high"}
            },
            {
              "id": "python.lang.security.audit.subprocess-shell-true",
              "properties": {"severity": "error"}
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "gitguardian.python-subprocess-shell",
          "level": "error",
          "message": {"text": "subprocess with shell=True enables command injection."},
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {"uri": "/src/app/handler.py"},
                "region": {
                  "startLine": 12,
                  "endLine": 12,
                  "snippet": {"text": "subprocess.call(cmd, shell=True)"}
                }
              }
            }
          ]
        },
        {
          "ruleId": "python.lang.security.audit.subprocess-shell-true",
          "level": "error",
          "message": {"text": "shell=True detected"},
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {"uri": "/src/lib/util.py"},
                "region": {"startLine": 40}
              }
            }
          ]
        },
        {
          "ruleId": "no-location-rule",
          "level": "warning",
          "message": {"text": "result without locations is skipped"},
          "locations": []
        }
      ]
    }
  ]
}
