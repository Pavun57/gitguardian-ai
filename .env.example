# --- GitHub App ---
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY_PATH=./secrets/github-app.pem
GITHUB_WEBHOOK_SECRET=
GITHUB_APP_BOT_NAME=gitguardian-ai

# --- Anthropic (Phase 1 fallback until BYOK dashboard exists) ---
ANTHROPIC_API_KEY=

# --- Infrastructure ---
DATABASE_URL=postgresql+asyncpg://gitguardian:gitguardian@localhost:5432/gitguardian
REDIS_URL=redis://localhost:6379/0

# --- BYOK encryption ---
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MASTER_ENCRYPTION_KEY=

# --- LangSmith observability ---
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=gitguardian-ai
LANGSMITH_TRACING=false

# --- Pipeline tuning ---
MAX_FINDINGS_PER_SCAN=3
MAX_FIX_ATTEMPTS=2
SCAN_BUDGET_USD=0.50
FIX_MODEL=claude-sonnet-4-5
CLASSIFY_MODEL=claude-haiku-4-5
MAX_FILE_LINES=1500

# --- Scanners / test isolation ---
SEMGREP_IMAGE=semgrep/semgrep:1.131.0
GITLEAKS_IMAGE=zricethezav/gitleaks:v8.28.0
TEST_RUNNER_IMAGE=gitguardian/test-runner:latest
SCAN_TIMEOUT_SECONDS=300
TEST_TIMEOUT_SECONDS=120

# --- Webhook tunnel (dev) ---
SMEE_CHANNEL_URL=

# --- Dashboard (Phase 2) ---
# OAuth App for dashboard login (separate from the GitHub App)
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
# Generate: openssl rand -hex 32
SESSION_SECRET=
DASHBOARD_URL=http://localhost:3000
API_BASE_URL=http://localhost:8000
