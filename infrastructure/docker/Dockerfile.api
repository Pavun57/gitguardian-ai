# API + worker image. Python 3.13 deliberately: asyncpg/langgraph wheels are the
# likeliest breakage point on 3.14. Same image serves both processes (different CMD).
FROM python:3.13-slim AS base

ENV PYTHONUNBUFFERED=1 \
    UV_LINK_MODE=copy

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    git curl docker.io nodejs npm \
    && rm -rf /var/lib/apt/lists/*

# Coding-agent CLIs for BYOA backends (claude_code / codex). Users authenticate
# with their own subscriptions — no API keys on our side.
RUN npm install -g @anthropic-ai/claude-code @openai/codex \
    && npm cache clean --force

COPY --from=ghcr.io/astral-sh/uv:latest /uv /usr/local/bin/uv

COPY pyproject.toml uv.lock* ./
# Dependencies only at this layer (cached unless pyproject/lock changes);
# --no-install-project because the package source isn't copied yet.
RUN uv sync --no-dev --frozen --no-install-project

COPY . .
# Now install the project itself (deps are already cached)
RUN uv sync --no-dev --frozen

ENV PATH="/app/.venv/bin:$PATH"

EXPOSE 8000
