# Hardened test-runner image for executing LLM-generated pytest suites.
# Spawned as a sibling container by the worker with: --network none, read-only FS,
# non-root user, mem/cpu/pid caps, cap-drop ALL (see security/runners/docker_base.py).
FROM python:3.13-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

RUN pip install --no-cache-dir "pytest~=8.3" "pytest-timeout~=2.4" \
    && useradd -m -u 1000 runner

USER 1000:1000
WORKDIR /work

ENTRYPOINT ["python", "-m", "pytest"]
