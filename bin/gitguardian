#!/usr/bin/env bash
#
# gitguardian — service manager for GitGuardian AI
#
#   gitguardian start       start all services (db, api, worker, dashboard, tunnel)
#   gitguardian stop        stop all services
#   gitguardian restart     restart app services (keeps db running)
#   gitguardian status      show what is running + URLs
#   gitguardian logs <svc>  tail logs (api|worker|dashboard)
#   gitguardian uninstall   stop everything and remove GitGuardian
#
set -euo pipefail

GG_HOME="${GG_HOME:-$HOME/gitguardian-ai}"
GG_STATE="$HOME/.gitguardian"
LOG_DIR="$GG_STATE/logs"
PID_DIR="$GG_STATE/pids"
COMPOSE_FILE="$GG_HOME/infrastructure/docker/docker-compose.yml"

say()  { printf "\033[1;32m==>\033[0m %s\n" "$*"; }
warn() { printf "\033[1;33m[!]\033[0m %s\n" "$*"; }
die()  { printf "\033[1;31m[x]\033[0m %s\n" "$*" >&2; exit 1; }

[ -d "$GG_HOME" ] || die "GitGuardian not found at $GG_HOME (set GG_HOME if installed elsewhere)"
mkdir -p "$LOG_DIR" "$PID_DIR"

_smee_channel() {
  # UI-saved value wins (app_config via API), then .env
  local ch
  ch=$(curl -s -m 2 http://localhost:8000/api/tunnel 2>/dev/null | grep -o '"channel_url":"[^"]*"' | cut -d'"' -f4 || true)
  if [ -z "$ch" ] && [ -f "$GG_HOME/.env" ]; then
    ch=$(grep -E '^SMEE_CHANNEL_URL=' "$GG_HOME/.env" | cut -d= -f2- || true)
  fi
  echo "$ch"
}

_start_bg() { # name, workdir, command...
  local name=$1 dir=$2; shift 2
  if [ -f "$PID_DIR/$name.pid" ] && kill -0 "$(cat "$PID_DIR/$name.pid")" 2>/dev/null; then
    warn "$name already running (pid $(cat "$PID_DIR/$name.pid"))"
    return
  fi
  (cd "$dir" && nohup "$@" > "$LOG_DIR/$name.log" 2>&1 & echo $! > "$PID_DIR/$name.pid")
  say "$name started (pid $(cat "$PID_DIR/$name.pid")) — log: $LOG_DIR/$name.log"
}

_stop() { # name
  local name=$1
  if [ -f "$PID_DIR/$name.pid" ]; then
    kill "$(cat "$PID_DIR/$name.pid")" 2>/dev/null || true
    rm -f "$PID_DIR/$name.pid"
    say "$name stopped"
  else
    warn "$name not running"
  fi
}

cmd_start() {
  say "Starting databases..."
  docker compose -f "$COMPOSE_FILE" up -d postgres redis

  say "Running migrations..."
  (cd "$GG_HOME" && uv run alembic upgrade head >/dev/null 2>&1) || warn "migrations skipped (db not ready yet?)"

  _start_bg api "$GG_HOME" uv run uvicorn apps.api.main:app --port 8000
  _start_bg worker "$GG_HOME" uv run arq agents.worker.WorkerSettings
  _start_bg dashboard "$GG_HOME/apps/dashboard" npm run dev

  local channel; channel=$(_smee_channel || true)
  if [ -n "$channel" ]; then
    docker rm -f gitguardian-smee >/dev/null 2>&1 || true
    docker run -d --name gitguardian-smee --network host --restart unless-stopped \
      node:22-alpine sh -c "npm install -g smee-client 2>/dev/null && smee --url $channel --target http://localhost:8000/webhooks/github" \
      >/dev/null
    say "webhook tunnel started → $channel"
  else
    warn "no smee channel configured — set one in the dashboard (Settings → Webhook tunnel)"
  fi

  echo
  cmd_status
}

cmd_stop() {
  _stop api; _stop worker; _stop dashboard
  docker rm -f gitguardian-smee >/dev/null 2>&1 && say "tunnel stopped" || true
}

cmd_status() {
  echo
  say "GitGuardian status"
  for name in api worker dashboard; do
    if [ -f "$PID_DIR/$name.pid" ] && kill -0 "$(cat "$PID_DIR/$name.pid")" 2>/dev/null; then
      printf "  \033[1;32m●\033[0m %-10s running (pid %s)\n" "$name" "$(cat "$PID_DIR/$name.pid")"
    else
      printf "  \033[1;31m●\033[0m %-10s stopped\n" "$name"
    fi
  done
  docker ps --format '{{.Names}}' | grep -q gitguardian-smee \
    && printf "  \033[1;32m●\033[0m %-10s running\n" "tunnel" \
    || printf "  \033[1;31m●\033[0m %-10s stopped\n" "tunnel"
  docker ps --format '{{.Names}}' | grep -q docker-postgres-1 \
    && printf "  \033[1;32m●\033[0m %-10s running\n" "postgres" \
    || printf "  \033[1;31m●\033[0m %-10s stopped\n" "postgres"
  docker ps --format '{{.Names}}' | grep -q docker-redis-1 \
    && printf "  \033[1;32m●\033[0m %-10s running\n" "redis" \
    || printf "  \033[1;31m●\033[0m %-10s stopped\n" "redis"
  echo
  echo "  Dashboard:  http://localhost:3000"
  echo "  Setup:      http://localhost:3000/setup"
  echo "  API docs:   http://localhost:8000/docs"
}

cmd_logs() {
  local name=${1:-api}
  [ -f "$LOG_DIR/$name.log" ] || die "no log for $name (api|worker|dashboard)"
  tail -f "$LOG_DIR/$name.log"
}

cmd_uninstall() {
  say "Stopping services..."
  cmd_stop || true
  say "Removing databases and volumes..."
  docker compose -f "$COMPOSE_FILE" down -v 2>/dev/null || true
  docker rmi gitguardian/test-runner:latest 2>/dev/null || true
  say "Removing $GG_HOME and CLI..."
  rm -rf "$GG_HOME" "$GG_STATE"
  rm -f "$HOME/.local/bin/gitguardian"
  echo
  say "GitGuardian AI uninstalled. Your GitHub App and repos are untouched."
}

case "${1:-}" in
  start)     cmd_start ;;
  stop)      cmd_stop ;;
  restart)   cmd_stop; sleep 1; cmd_start ;;
  status)    cmd_status ;;
  logs)      cmd_logs "${2:-api}" ;;
  uninstall) cmd_uninstall ;;
  *)         grep '^#' "$0" | head -10 | sed 's/^# \{0,1\}//' ;;
esac
